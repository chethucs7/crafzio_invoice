# ============ Production env for VPS ============
# Copy to /var/www/crafzio/backend/.env and edit values.
# NEVER commit this file with real secrets.

FLASK_ENV=production
FORCE_HSTS=true

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING
JWT_SECRET_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_STRING

# MySQL on the VPS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=crafzio
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_NAME=crafzio

# Comma-separated list — MUST be your real frontend origins, no wildcards.
CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com

# Uploads
UPLOAD_FOLDER=/var/www/crafzio/backend/app/static/uploads
MAX_CONTENT_LENGTH_MB=16

# SMTP (Gmail App Password recommended)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=you@yourdomain.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=Crafzio <you@yourdomain.com>

# Admin seed (used on first migrate; CHANGE THE PASSWORD AFTER FIRST LOGIN)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Gunicorn
GUNICORN_BIND=127.0.0.1:5000
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
