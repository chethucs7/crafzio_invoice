[Unit]
Description=Crafzio Backend API (Gunicorn)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/crafzio/backend
EnvironmentFile=/var/www/crafzio/backend/.env
ExecStart=/var/www/crafzio/backend/venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/crafzio/backend/app/static/uploads

[Install]
WantedBy=multi-user.target
